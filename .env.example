PANDA_TRACE_ENV=dev
PANDA_TRACE_STORE=memory
PANDA_TRACE_API_HOST=0.0.0.0
PANDA_TRACE_API_PORT=8000
PANDA_TRACE_API_PUBLISH_HOST=127.0.0.1
PANDA_TRACE_API_PUBLISH_PORT=8000
PANDA_TRACE_SERVICE_PUBLISH_HOST=127.0.0.1
RATE_LIMIT_BACKEND=memory
TAIL_BACKEND=memory
REDACTION_MODE=disabled
REQUIRE_HTTPS=false
BOOTSTRAP_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=panda_trace
POSTGRES_USER=panda
POSTGRES_PASSWORD=panda
# Optional explicit override. Leave empty to build the DSN from POSTGRES_* above.
POSTGRES_DSN=
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=panda_trace
CLICKHOUSE_USER=panda
CLICKHOUSE_PASSWORD=panda
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=panda
MINIO_SECRET_KEY=panda-secret
MINIO_BUCKET=panda-trace

LOG_RETENTION_DAYS=730
MAX_LOG_BYTES=262144
MAX_BATCH_BYTES=10485760
MAX_BATCH_ITEMS=1000
MAX_ATTACHMENT_BYTES=52428800
MAX_REQUEST_BYTES=73400320
MAX_SEARCH_RANGE_DAYS=31
MAX_PAGE_SIZE=500
MAX_EXPORT_ROWS=10000
RATE_LIMIT_PER_MINUTE=600
MAX_KEY_DAILY_INGEST_BYTES=268435456
MAX_PROJECT_DAILY_INGEST_BYTES=1073741824
MAX_AGENT_DAILY_READ_QUERIES=10000
MAX_CONCURRENT_TAIL_STREAMS=25
TAIL_IDLE_TIMEOUT_SECONDS=300
